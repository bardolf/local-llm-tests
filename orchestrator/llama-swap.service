# systemd --user služba orchestrátoru.
# Instalace:  orchestrator/install.sh   (symlink do ~/.config/systemd/user/)
[Unit]
Description=llama-swap – orchestrátor lokálních AI modelů (Vulkan, RX 6600)
After=network-online.target

[Service]
ExecStart=%h/projects/local-llm-tests/engines/llama-swap/llama-swap \
  -config %h/projects/local-llm-tests/orchestrator/config.yaml \
  -listen 0.0.0.0:8100 \
  -watch-config
Restart=on-failure
RestartSec=5
# backendy (llama-server, whisper-server) jsou child procesy – při stopu zabít celou skupinu
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=default.target
